# Infisical Universal Auth Machine Identity credentials.
INFISICAL_CLIENT_ID=replace-with-machine-identity-client-id
INFISICAL_CLIENT_SECRET=replace-with-machine-identity-client-secret

# Infisical project and the environment/folder whose secrets are exposed by GET /secrets.
INFISICAL_PROJECT_ID=replace-with-project-id
# Exact environment slug from Project Settings -> Environments (for example: dev, staging, prod).
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
# Optional. Background refresh interval in seconds. Default: 3600 (1 hour).
INFISICAL_REFRESH_INTERVAL_SECONDS=3600

# Optional: leave unset for Infisical Cloud. Set it for a self-hosted instance.
INFISICAL_URL=https://infisical-server.ru

# Optional: false returns secrets from INFISICAL_SECRET_PATH only.
INFISICAL_RECURSIVE=false
